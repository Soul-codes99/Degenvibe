# Robinhood Chain Testnet
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
VAULT=0xc70b231A670A4DDa8b761Bcd9f4431278458F8aa
# SHOP is no longer needed: characters unlock by ETH wagered
# Secrets: set these in your host's secret settings, never commit them
OPERATOR_PRIVATE_KEY=
SESSION_SECRET=
CRON_SECRET=
DATABASE_URL=
ALLOWED_ORIGIN=https://your-game-site.example
# Optional: wager needed to unlock characters, in wei (defaults: Soul 0.5 ETH, Ember 0.1 ETH, Frost 0.1 ETH)
# UNLOCK_SOUL_WEI=500000000000000000
# UNLOCK_EMBER_WEI=100000000000000000
# UNLOCK_FROST_WEI=100000000000000000
# Holding path: whole $SOUL a wallet must hold to unlock a blob while it holds it (defaults below)
# SOUL_TOKEN=0xA1B60F81a18e42ec71cee5B32FAf09239067a057
# HOLD_SOUL_TOKENS=6430000
# HOLD_EMBER_TOKENS=2150000
# HOLD_FROST_TOKENS=2150000
